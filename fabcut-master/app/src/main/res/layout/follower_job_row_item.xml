<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="true"
    android:layout_margin="8dp"
    android:padding="16dp"
    app:cardBackgroundColor="@color/colorWhite"
    app:cardCornerRadius="6dp"
    app:cardElevation="4dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/barcode"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorBlack"
            android:textStyle="bold"
            android:text="7G0sfh^Y" />

        <LinearLayout
            android:paddingTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorGreyText"
                    android:text="@string/expected_plies" />

                <TextView
                    android:id="@+id/expected_plies"
                    android:paddingTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorBlack"
                    android:textStyle="bold"
                    android:text="120" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorGreyText"
                    android:text="@string/actual_plies" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp">


                    <RelativeLayout
                        android:id="@+id/plies_container"
                        android:background="@drawable/circular_corners"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <EditText
                            android:background="@android:color/transparent"
                            android:id="@+id/actual_plies"
                            android:paddingStart="12dp"
                            android:inputType="number|numberDecimal"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom= "8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/colorBlack"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:text="120"
                            android:singleLine="true" />

                        <ProgressBar
                            android:layout_toEndOf="@id/actual_plies"
                            android:layout_toRightOf="@id/actual_plies"
                            android:id="@+id/loader"
                            android:padding="8dp"
                            android:layout_centerVertical="true"
                            android:layout_width="wrap_content"
                            android:visibility="invisible"
                            android:layout_height="wrap_content"
                            style="?android:attr/progressBarStyleSmall" />

                    </RelativeLayout>

                    <ImageView
                        android:layout_toEndOf="@id/plies_container"
                        android:layout_toRightOf="@id/plies_container"
                        android:layout_centerVertical="true"
                        android:layout_margin="8dp"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:id="@+id/feedback_icon"
                        android:visibility="invisible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_check" />

                </RelativeLayout>


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_gravity="center"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:background="@drawable/circular_corners"
                    android:padding="8dp"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content">

                    <Spinner
                        android:entries="@array/reason_options"
                        android:id="@+id/reason_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>

            </LinearLayout>


            <ImageView
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:id="@+id/delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ic_delete" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>